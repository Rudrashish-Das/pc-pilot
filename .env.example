# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- Discord
DISCORD_TOKEN=
# Server ID(s) for instant slash-command sync, comma-separated for several servers: GUILD_ID=111,222
# Empty = global commands: every server the bot is in plus DMs, but new/changed commands can take a while to appear.
GUILD_ID=
# Comma-separated user IDs allowed to use the bot at all. Empty = everyone in the server (DMs: owners only).
ALLOWED_USER_IDS=
# Comma-separated user IDs allowed to use Claude Code / change its settings.
# Empty = falls back to ALLOWED_USER_IDS. Both empty = Claude Code disabled.
OWNER_IDS=

# ---------------------------------------------------------------- Telegram (optional)
# Same bot, second front end: from @BotFather -> /newbot. Leave empty for Discord only.
# (Telegram only is fine too: then leave DISCORD_TOKEN empty.)
TELEGRAM_BOT_TOKEN=
# Your Telegram user id(s), comma-separated. Required: empty = the bot answers nobody on Telegram
# (it only tells /start your id, so you can fill this in).
TELEGRAM_ALLOWED_USER_IDS=
# Telegram users allowed to use Claude Code. Empty = same as TELEGRAM_ALLOWED_USER_IDS.
TELEGRAM_OWNER_IDS=

# ---------------------------------------------------------------- Local engine
# Any OpenAI-compatible base URL (the bot appends /chat/completions and /models)
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   llama.cpp:  http://localhost:8080/v1
#   LiteLLM:    http://localhost:4000/v1
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
# Only needed for servers that require a key (e.g. a LiteLLM gateway)
LLM_API_KEY=
TIMEZONE=Asia/Kolkata
# Optional: use SearXNG (JSON API enabled) instead of DuckDuckGo, e.g. http://localhost:8888
SEARXNG_URL=
# Optional: replaces the default system prompt (the timezone is appended; the time goes at the top of each message)
SYSTEM_PROMPT=
# Plain local engine memory: how many recent exchanges it resends, and a size cap (characters) so long answers
# can't overflow the model's context window. Past the count it drops the oldest quarter at once, which keeps
# Ollama's prompt cache valid for the next few messages.
LLM_HISTORY_TURNS=20
LLM_HISTORY_CHARS=40000
# Seconds of inactivity before the bot unloads Ollama models it used, freeing VRAM/RAM.
# Models load only on the first message or scheduled run. 0 = leave it to Ollama's keep_alive (default 5m).
LLM_IDLE_UNLOAD=600

# ---------------------------------------------------------------- Claude Code
# Leave empty to find `claude` on PATH
CLAUDE_BIN=
# Whitelisted project folders: name=path;name=path  (relative paths are relative to bot.py)
WORKSPACES=default=./claude_workspace
# local | claude | auto
DEFAULT_ENGINE=local
# anthropic | ollama | custom
CC_BACKEND=anthropic
# anthropic: sonnet | opus | fable | haiku ; ollama/custom: the model name
CC_MODEL=sonnet
# read | edit | full   (full = bypassPermissions, always asks for confirmation)
CC_PERMISSION=edit
# Seconds before a Claude Code job is killed
CLAUDE_TIMEOUT=900
# Ollama server used by the Claude Code "ollama" backend
OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------- Custom gateway (Claude Code "custom" backend)
# An Anthropic-compatible endpoint, e.g. a LiteLLM proxy: http://localhost:4000
CC_CUSTOM_BASE_URL=
CC_CUSTOM_TOKEN=
# Comma-separated model names offered in the panel
CC_CUSTOM_MODELS=

# ---------------------------------------------------------------- Chat
# Extra slash command named after your bot: BOT_COMMAND=jarvis gives /jarvis <prompt> (lowercase, no spaces)
BOT_COMMAND=
# /ask, @mentions and /<BOT_COMMAND> continue the channel's Claude Code session (true) or start fresh each time (false)
CC_CONTINUE=true

# ---------------------------------------------------------------- Cost controls (Claude Code, Anthropic backend)
# Stop a single job once it has spent this much (API-equivalent USD). 0 = no cap.
CC_MAX_BUDGET_USD=1.0
# Refuse new jobs once today's total reaches this (resets at midnight in TIMEZONE). 0 = no cap. Shown in /panel.
CC_DAILY_BUDGET_USD=5.0
# low | medium | high | xhigh | max. Empty = CLI default. "low" is cheapest and fine for chat and quick questions.
CC_EFFORT=
# true = also load your MCP servers, skills and plugins (adds ~24k tokens to every call). Default: off.
CC_EXTRAS=false

# ---------------------------------------------------------------- Security
# Env vars with secret-looking names (TOKEN, KEY, SECRET, PASSWORD...) are removed from Claude Code's environment,
# except ANTHROPIC_* / CLAUDE_*. List any it genuinely needs here, e.g. GITHUB_TOKEN for `gh` in full-access jobs.
CC_ENV_PASSTHROUGH=

# Start a fresh Claude Code session after this many idle minutes (cache expires after 1h; 0 = never)
CC_SESSION_IDLE_MINUTES=60

# Optional: replace the instruction added to Claude Code's prompt (Discord context, use WebSearch for current info,
# paste files instead of referring to them). Leave unset to use the built-in text. Changing it starts new sessions.
# CC_SYSTEM_APPEND=

# Suggest compacting (card hint, highlighted button, /panel) once a session's context passes this many tokens.
# A fresh session is ~11k. 0 = never suggest.
CC_COMPACT_HINT_TOKENS=50000

# Reply style for /ask, /<BOT_COMMAND>, @mentions and replies: chat (plain messages + one small stats line) or cards
# (embeds + buttons). Change per channel in /panel -> Settings.
REPLY_STYLE=chat

# ---------------------------------------------------------------- Voice notes
# Discord voice messages are transcribed on this laptop (faster-whisper) and answered like typed messages.
VOICE_ENABLED=true
# Per-channel default (change in /panel -> Settings): all | replies (only voice replies to the bot) | off
VOICE_DEFAULT=all
# tiny | base | small | medium | large-v3. small = good accuracy, ~460 MB, a few seconds per short note on CPU.
WHISPER_MODEL=small
# cpu keeps the GPU free for Ollama; cuda + float16 is faster if you have VRAM to spare
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Empty = auto-detect language; set e.g. en or hi to force one
WHISPER_LANGUAGE=
VOICE_MAX_SECONDS=180

# ---------------------------------------------------------------- Storage (optional)
# Empty = settings, tasks, reminders, usage, chat memory and job history are JSON files in data/.
# Set a Postgres URL to keep them in a database instead (tables are created on first start; existing data/
# files are imported once). Example: postgresql://postgres:yourpassword@localhost:5432/llmbot
DATABASE_URL=

# ---------------------------------------------------------------- Logs
# data/bot.log rolls over into dated archives (bot-YYYYMMDD-HHMMSSmmm.log.gz); the oldest are deleted so all log
# files together (incl. data/jobs.jsonl when not on Postgres) never use more than LOG_MAX_TOTAL_MB.
LOG_MAX_TOTAL_MB=2048
# Size at which the live log rolls over (at most a quarter of LOG_MAX_TOTAL_MB).
LOG_FILE_MB=50
# gzip the archives (about 10x smaller).
LOG_COMPRESS=true
# Also delete archives older than this many days. 0 = keep until the size cap needs the room.
LOG_KEEP_DAYS=0
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
